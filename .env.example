# Loaded automatically by ./dev; do not commit real credentials or
# machine-specific paths from the copied .env file.
DATABASE_URL=postgres://plamenu:plamenu@127.0.0.1:5433/plamenu_dev
RUST_LOG=plamenu=debug,tower_http=info

# Disposable local server settings.
PLAMENU_DOMAIN=plamenu.local
PLAMENU_BIND=0.0.0.0:8420
# Defaults to the ignored .dev/media directory. Point this at an existing
# absolute media store only when deliberately reusing its development DB.
# PLAMENU_MEDIA_DIR=/absolute/path/to/development/media
PLAMENU_DEV_USER=developer
PLAMENU_DEV_EMAIL=developer@plamenu.local
PLAMENU_DEV_PASSWORD=plamenu-development-only
# Development-only default exists in ./dev; override it when intentionally
# testing envelope-root rotation.
# PLAMENU_ENCRYPTION_SECRET=another-development-root-at-least-32-bytes
# PLAMENU_ONION_PROXY_URL=socks5h://127.0.0.1:9350

# The live-federation harness defaults to e2e/peers. Override these only to use
# a separately managed compatible fleet.
# PLAMENU_PEER_ROOT=/absolute/path/to/activitypub-peer-workspace
# PLAMENU_PEER_DEV=/absolute/path/to/activitypub-peer-workspace/dev

# Every live-peer URL can also be overridden for a remotely hosted test fleet.
# MASTODON_URL=https://mastodon.local
# PLEROMA_URL=https://pleroma.local
# SHARKEY_URL=https://sharkey.local
# GOTOSOCIAL_URL=https://gotosocial.local
# MITRA_URL=https://mitra.local
# LEMMY_URL=https://lemmy.local
# PEERTUBE_URL=https://peertube.local
# DISCOURSE_URL=https://discourse.local
# HUBZILLA_URL=https://hubzilla.local
# FUNKWHALE_URL=https://funkwhale.local
