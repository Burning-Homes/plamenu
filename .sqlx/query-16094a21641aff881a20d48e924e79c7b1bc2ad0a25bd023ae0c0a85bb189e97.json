{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, account_id, from_account_id, last_status_id,\n               notifications_count, created_at, updated_at\n        FROM notification_requests\n        WHERE account_id = $1\n          AND ($2::bigint IS NULL OR id < $2)\n          AND ($3::bigint IS NULL OR id > $3)\n        ORDER BY id DESC\n        LIMIT $4\n        ",
