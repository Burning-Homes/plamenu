{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT q.id AS \"quote_id!\", q.status_id AS \"status_id!\"\n        FROM quotes q\n        WHERE q.quoted_status_id = $1 AND q.state = 'accepted'\n          AND q.status_id IS NOT NULL\n          AND ($2::bigint IS NULL OR q.id < $2)\n          AND ($3::bigint IS NULL OR q.id > $3)\n        ORDER BY q.id DESC\n        LIMIT $4\n        ",
