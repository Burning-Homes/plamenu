  "query": "\n        SELECT id,\n               (suspended_at IS NULL\n                AND (portable OR COALESCE(instance_domain_allowed(domain), false))) AS \"allowed!\",\n               (domain IS NULL OR portable) AS \"is_local!\"\n        FROM accounts\n        WHERE id = ANY($1)\n        ",
