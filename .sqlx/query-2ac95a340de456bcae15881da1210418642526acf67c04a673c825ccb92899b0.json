{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT oauth_apps.name AS \"key?\", count(*) AS \"value!\"\n        FROM users\n        LEFT JOIN oauth_apps ON oauth_apps.id = users.created_by_application_id\n        WHERE users.created_at BETWEEN $1 AND $2\n        GROUP BY oauth_apps.name\n        ORDER BY count(*) DESC\n        LIMIT $3\n        ",
