{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT f.id AS \"row_id!\", f.account_id AS \"account_id!\"\n        FROM favourites f\n        WHERE f.status_id = $1\n          AND ($2::bigint IS NULL OR f.id < $2)\n          AND ($3::bigint IS NULL OR f.id > $3)\n          AND NOT account_hidden($4, f.account_id)\n        ORDER BY f.id DESC\n        LIMIT $5\n        ",
