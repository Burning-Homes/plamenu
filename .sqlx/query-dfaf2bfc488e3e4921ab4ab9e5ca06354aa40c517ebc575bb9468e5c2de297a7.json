  "query": "\n        UPDATE tags SET\n            display_name = COALESCE($2, display_name),\n            usable       = COALESCE($3, usable),\n            listable     = COALESCE($4, listable),\n            trendable    = COALESCE($5, trendable),\n            reviewed_at  = $6\n        WHERE id = $1\n        RETURNING id, name, display_name, usable, listable, trendable, reviewed_at\n        ",
