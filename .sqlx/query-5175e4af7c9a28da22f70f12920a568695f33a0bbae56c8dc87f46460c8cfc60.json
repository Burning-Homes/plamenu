  "query": "\n        SELECT relay_id,\n               COALESCE(SUM(count), 0)::bigint AS \"total!\",\n               COALESCE(SUM(count) FILTER (\n                   WHERE day >= (now() AT TIME ZONE 'UTC')::date - 6), 0)::bigint\n                   AS \"last_week!\"\n        FROM relay_daily_activities\n        GROUP BY relay_id\n        ",
