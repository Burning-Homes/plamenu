  "query": "\n        SELECT id, name, display_name, usable, listable, trendable, reviewed_at\n        FROM tags\n        WHERE ($1::bigint IS NULL OR id < $1) AND ($2::bigint IS NULL OR id > $2)\n        ORDER BY id DESC\n        LIMIT $3\n        ",
