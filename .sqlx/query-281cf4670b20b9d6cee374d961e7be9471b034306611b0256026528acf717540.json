  "db_name": "PostgreSQL",
  "query": "\n        SELECT a.id AS \"account_id!\", a.username,\n               CASE WHEN a.portable THEN NULL ELSE a.domain END AS domain\n        FROM follows f JOIN accounts a ON a.id = f.target_account_id\n        WHERE f.account_id = $1 AND NOT f.pending\n        ",
