{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT q.account_id AS \"account_id!\", q.status_id AS \"status_id!\"\n        FROM quotes q\n        JOIN accounts a ON a.id = q.account_id\n        WHERE q.quoted_status_id = $1 AND q.state = 'accepted'\n          AND q.status_id IS NOT NULL AND a.domain IS NULL\n        ORDER BY q.id\n        ",
