  "db_name": "PostgreSQL",
  "query": "\n        UPDATE webhook_delivery_jobs SET\n            attempts = attempts + 1,\n            run_at = now() + make_interval(secs => $2)\n        WHERE id IN (\n            SELECT id FROM webhook_delivery_jobs\n            WHERE run_at <= now()\n            ORDER BY run_at\n            LIMIT $1\n            FOR UPDATE SKIP LOCKED\n        )\n        RETURNING id, webhook_id, event, body, attempts\n        ",
