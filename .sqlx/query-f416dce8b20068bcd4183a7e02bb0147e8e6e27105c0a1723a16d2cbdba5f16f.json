{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT tf.id AS \"follow_id!\", t.id AS \"id!\", t.name AS \"name!\",\n               t.display_name\n        FROM tag_follows tf\n        JOIN tags t ON t.id = tf.tag_id\n        WHERE tf.account_id = $1\n          AND ($2::bigint IS NULL OR tf.id < $2)\n          AND ($3::bigint IS NULL OR tf.id > $3)\n        ORDER BY tf.id DESC\n        LIMIT $4\n        ",
