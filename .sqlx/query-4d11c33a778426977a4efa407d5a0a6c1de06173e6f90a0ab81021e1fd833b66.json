  "query": "\n        UPDATE quote_verify_jobs SET run_at = now() + make_interval(secs => $2)\n        WHERE id IN (\n            SELECT id FROM quote_verify_jobs\n            WHERE run_at <= now()\n            ORDER BY run_at\n            LIMIT $1\n            FOR UPDATE SKIP LOCKED\n        )\n        RETURNING id, quote_id, attempts\n        ",
