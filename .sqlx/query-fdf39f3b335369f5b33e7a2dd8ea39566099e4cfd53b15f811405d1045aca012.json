  "query": "\n        SELECT id, domain, created_at, updated_at\n        FROM domain_allows\n        WHERE ($1::bigint IS NULL OR id < $1)\n          AND ($2::bigint IS NULL OR id > $2)\n          AND ($3::bigint IS NULL OR id > $3)\n        ORDER BY id * (CASE WHEN $4 THEN 1 ELSE -1 END)\n        LIMIT $5\n        ",
