  "query": "\n        SELECT r.id, r.name, r.color, r.position, r.permissions, r.highlighted,\n               r.created_at, r.updated_at\n        FROM user_roles r\n        JOIN users u ON u.role_id = r.id\n        WHERE u.account_id = $1\n        ",
