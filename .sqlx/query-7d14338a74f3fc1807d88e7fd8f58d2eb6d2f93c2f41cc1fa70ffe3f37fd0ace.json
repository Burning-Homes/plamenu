{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT f.target_account_id AS \"target_account_id!\",\n               target.username AS \"target_username!\", f.uri AS edge_uri,\n               f.pending\n        FROM follows f\n        JOIN accounts target ON target.id = f.target_account_id\n        WHERE f.account_id = $1 AND target.domain IS NULL\n        ORDER BY f.id\n        ",
