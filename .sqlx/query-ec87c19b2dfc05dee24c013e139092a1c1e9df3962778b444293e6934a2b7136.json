{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT b.id AS cursor, a.username,\n               CASE WHEN a.portable THEN NULL ELSE a.domain END AS domain\n        FROM blocks b\n        JOIN accounts a ON a.id = b.target_account_id\n        WHERE b.account_id = $1 AND ($2::bigint IS NULL OR b.id < $2)\n        ORDER BY b.id DESC\n        LIMIT $3\n        ",
