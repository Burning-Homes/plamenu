  "query": "\n        UPDATE account_media_jobs SET run_at = now() + make_interval(secs => $2)\n        WHERE id IN (\n            SELECT id FROM account_media_jobs\n            WHERE run_at <= now()\n            ORDER BY run_at\n            LIMIT $1\n            FOR UPDATE SKIP LOCKED\n        )\n        RETURNING id, account_id, which, attempts\n        ",
