  "query": "\n        SELECT tag_id AS \"tag_id!\", day AS \"day!\",\n               COALESCE(sum(uses), 0)::bigint AS \"uses!\",\n               count(*)::bigint AS \"accounts!\"\n        FROM tag_usages\n        WHERE tag_id = $1 AND day >= $2\n        GROUP BY tag_id, day\n        ",
