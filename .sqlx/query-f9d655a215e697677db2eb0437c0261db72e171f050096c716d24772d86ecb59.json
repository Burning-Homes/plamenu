  "query": "\n        UPDATE rules SET\n            text       = COALESCE($2, text),\n            hint       = COALESCE($3, hint),\n            priority   = COALESCE($4, priority),\n            updated_at = now()\n        WHERE id = $1 AND deleted_at IS NULL\n        RETURNING id, priority, text, hint, deleted_at, created_at, updated_at\n        ",
