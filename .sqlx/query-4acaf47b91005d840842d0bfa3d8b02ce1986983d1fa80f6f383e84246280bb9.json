  "query": "\n        SELECT f.account_id AS \"id!\"\n        FROM follows f\n        JOIN accounts a ON a.id = f.account_id\n        WHERE f.target_account_id = $1 AND a.domain IS NULL AND NOT f.pending\n        ORDER BY f.account_id\n        ",
