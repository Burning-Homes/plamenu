  "query": "\n        SELECT st.status_id AS \"status_id!\", t.name AS \"name!\"\n        FROM status_tags st\n        JOIN tags t ON t.id = st.tag_id\n        WHERE st.status_id = ANY($1)\n        ORDER BY t.name\n        ",
