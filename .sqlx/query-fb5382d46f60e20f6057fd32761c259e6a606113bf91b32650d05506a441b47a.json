  "query": "\n        SELECT preview_card_id AS \"preview_card_id!\", day AS \"day!\",\n               COALESCE(sum(uses), 0)::bigint AS \"uses!\",\n               count(*)::bigint AS \"accounts!\"\n        FROM preview_card_usages\n        WHERE preview_card_id = ANY($1) AND day >= $2\n        GROUP BY preview_card_id, day\n        ",
