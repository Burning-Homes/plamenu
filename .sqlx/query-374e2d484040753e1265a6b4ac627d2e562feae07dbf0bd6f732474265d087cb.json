  "query": "\n        SELECT id, app_id, user_id, scopes, created_at, last_used_at\n        FROM oauth_tokens\n        WHERE user_id = $1 AND app_id = $2 AND revoked_at IS NULL\n        ORDER BY created_at DESC\n        LIMIT 1\n        ",
