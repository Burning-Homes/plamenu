  "query": "\n        SELECT id AS \"id!\", target_account_id AS \"target_account_id!\"\n        FROM account_endorsements\n        WHERE account_id = $1\n          AND ($2::bigint IS NULL OR id < $2)\n          AND ($3::bigint IS NULL OR id > $3)\n        ORDER BY id DESC\n        LIMIT $4\n        ",
