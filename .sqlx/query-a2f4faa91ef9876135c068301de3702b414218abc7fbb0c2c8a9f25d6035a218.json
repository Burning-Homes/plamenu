  "query": "\n        SELECT l.id, l.account_id, l.title, l.replies_policy, l.exclusive\n        FROM lists l\n        JOIN list_accounts la ON la.list_id = l.id\n        WHERE l.account_id = $1 AND la.account_id = $2\n        ORDER BY l.id\n        ",
