{
  "db_name": "PostgreSQL",
  "query": "\n        UPDATE reply_fetch_jobs SET\n            run_at = now() + make_interval(secs => $2),\n            attempts = attempts + 1\n        WHERE id IN (\n            SELECT id FROM reply_fetch_jobs\n            WHERE run_at <= now()\n            ORDER BY run_at\n            LIMIT $1\n            FOR UPDATE SKIP LOCKED\n        )\n        RETURNING id, status_id, attempts\n        ",
