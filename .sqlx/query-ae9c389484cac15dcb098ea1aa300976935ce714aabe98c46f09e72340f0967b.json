  "query": "\n        SELECT t.id, t.name, t.display_name\n        FROM tag_trends tr\n        JOIN tags t ON t.id = tr.tag_id\n        WHERE tr.allowed\n        ORDER BY tr.score DESC, t.id DESC\n        LIMIT $1 OFFSET $2\n        ",
