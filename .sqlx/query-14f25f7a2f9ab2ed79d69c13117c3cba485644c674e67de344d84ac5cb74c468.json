  "db_name": "PostgreSQL",
  "query": "\n        SELECT g.account_id, g.membership_policy, g.posting_policy,\n               g.sensitive, g.created_by, g.created_at\n        FROM groups g\n        JOIN status_mentions sm ON sm.account_id = g.account_id\n        WHERE sm.status_id = $1\n        ORDER BY g.account_id\n        ",
