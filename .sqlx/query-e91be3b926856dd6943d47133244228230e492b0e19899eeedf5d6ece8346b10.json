  "query": "\n        SELECT t.id, t.name, t.display_name, t.usable, t.listable, t.trendable,\n               t.reviewed_at\n        FROM tag_trends tr\n        JOIN tags t ON t.id = tr.tag_id\n        ORDER BY tr.score DESC, t.id DESC\n        LIMIT $1 OFFSET $2\n        ",
