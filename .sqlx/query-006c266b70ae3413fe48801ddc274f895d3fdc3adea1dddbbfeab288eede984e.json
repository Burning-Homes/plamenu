  "query": "\n        SELECT u.account_id AS \"account_id!\",\n               u.noindex AS \"noindex!\",\n               r.id AS \"role_id?\", r.name AS \"role_name?\", r.color AS \"role_color?\"\n        FROM users u\n        LEFT JOIN user_roles r ON r.id = u.role_id AND r.highlighted\n        WHERE u.account_id = ANY($1)\n        ",
