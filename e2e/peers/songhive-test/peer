#!/usr/bin/env bash
set -euo pipefail
ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
compose() { docker compose -f "$ROOT/compose.dev.yml" "$@"; }
case "${1:-up}" in
  up)
    compose up -d --wait postgres redis songhive
    if ! compose exec -T postgres psql -U songhive -tAc "SELECT 1 FROM users WHERE username='sylvia'" | grep -q 1; then
    compose exec -T songhive songhive admin create-user --username sylvia \
      --email sylvia@songhive.local --password songhive-sylvia-pass-123 --admin
    fi
    compose up -d worker
    ;;
  down) compose down ;;
  status) compose ps ;;
  logs) shift; compose logs -f "$@" ;;
  *) echo 'usage: peer {up|down|status|logs}' >&2; exit 2 ;;
esac
