# ── Mobilizon (disposable interop instance) ───────────────────────────

mobilizon_up() {
  echo ">> Starting Mobilizon interop stack…"
  # Same guard as the other peers: the compose file joins the shared
  # mastodon-test_internal network as external, so the Mastodon stack (which
  # owns it, and runs the Caddy that terminates TLS for mobilizon.local) has
  # to be up first. Never create the network ourselves.
  if ! docker_cmd network inspect mastodon-test_internal >/dev/null 2>&1; then
    echo "   the shared 'mastodon-test_internal' network is missing."
    echo "   Start the Mastodon stack first:  ./dev up mastodon"
    return 1
  fi
  mobilizon_compose up -d --wait
  mobilizon_wait_ready
  mobilizon_ensure_account
  mobilizon_ensure_group
  echo "   https://mobilizon.local"
  mobilizon_creds
}

# Wait until the vhost answers through Caddy (the container healthcheck only
# proves Phoenix is up on :4000; this also confirms TLS routing).
mobilizon_wait_ready() {
  echo ">> Waiting for https://mobilizon.local/.well-known/nodeinfo …"
  for _ in $(seq 1 60); do
    if curl -sk --max-time 5 https://mobilizon.local/.well-known/nodeinfo >/dev/null 2>&1; then
      return 0
    fi
    sleep 2
  done
  echo "   (mobilizon.local not answering through Caddy yet — is the mastodon stack up?)"
  return 0
}

# Ensure the standing `grace` account exists, pre-confirmed and with a
# profile. Mobilizon's data model splits user (login) from actor (profile):
# `users.new` without --profile_username creates a user that must pick a
# profile interactively at first login, which is useless to a test harness —
# so both are passed and the actor @grace@mobilizon.local exists immediately.
# NB the flags are DASHED (--profile-username): Elixir's OptionParser rejects
# switches spelled with underscores even though the strict key is
# :profile_username, and the task dies with a MatchError on the leftovers.
# Idempotent: a second run just reports the user already exists.
mobilizon_ensure_account() {
  if mobilizon_compose exec -T mobilizon /bin/mobilizon_ctl users.show \
      "$MOBILIZON_DEV_EMAIL" >/dev/null 2>&1; then
    echo "   account $MOBILIZON_DEV_EMAIL already present"
    return 0
  fi
  echo ">> Creating $MOBILIZON_DEV_EMAIL (profile $MOBILIZON_DEV_USER, administrator)…"
  if ! mobilizon_compose exec -T mobilizon /bin/mobilizon_ctl users.new \
      "$MOBILIZON_DEV_EMAIL" \
      --password "$MOBILIZON_DEV_PASSWORD" \
      --profile-username "$MOBILIZON_DEV_USER" \
      --profile-display-name "Grace" \
      --admin >/dev/null 2>&1; then
    echo "   (user creation failed — instance is up; see mobilizon-test/README.md)"
  fi
}

# Ensure the standing `plamenu_events` group exists.
#
# This is not cosmetic seeding like PeerTube's test video: Mobilizon REFUSES
# to be followed as a Person ("Only group and instances can be followed",
# actors.ex `follow(_, _, _, _), do: {:error, :person_no_follow}` — only
# :Group and the :Application relay actor pass). So a followable Group is the
# ONLY way a peer can receive this instance's events, and every e2e scenario
# needs one. Idempotent: existence is probed over ActivityPub.
mobilizon_ensure_group() {
  local base="https://mobilizon.local" group="plamenu_events"
  command -v jq >/dev/null 2>&1 || { echo "   (jq not found — skipping group seed)"; return 0; }

  if curl -sk --max-time 10 -H 'Accept: application/activity+json' \
      "$base/@$group" | jq -e '.type == "Group"' >/dev/null 2>&1; then
    echo "   group !$group@mobilizon.local already present"
    return 0
  fi

  local token actor
  # shellcheck disable=SC2016 # GraphQL variables are literal; shell values are spliced into JSON.
  token=$(mobilizon_graphql '{"query":"mutation($e:String!,$p:String!){ login(email:$e, password:$p){ accessToken } }","variables":{"e":"'"$MOBILIZON_DEV_EMAIL"'","p":"'"$MOBILIZON_DEV_PASSWORD"'"}}' \
    | jq -r '.data.login.accessToken // empty')
  if [ -z "$token" ]; then
    echo "   (could not log in as $MOBILIZON_DEV_EMAIL — see mobilizon-test/README.md)"
    return 0
  fi
  # Cache the token: the e2e helper reuses it rather than logging in again.
  printf '%s\n' "$token" > "$MOBILIZON_DIR/.grace-token"

  echo ">> Creating group !$group@mobilizon.local …"
  actor=$(mobilizon_graphql '{"query":"mutation{ createGroup(preferredUsername:\"'"$group"'\", name:\"Plamenu e2e events\", summary:\"Events for federation tests\", visibility: PUBLIC, openness: OPEN){ url } }"}' "$token" \
    | jq -r '.data.createGroup.url // empty')
  if [ -z "$actor" ]; then
    echo "   (group creation failed — instance is up; see mobilizon-test/README.md)"
  fi
}

# POST a GraphQL document to Mobilizon's single /api endpoint. $2 is an
# optional bearer token. Mobilizon has no REST API — everything a test
# harness does (login, groups, events, participation) goes through here.
mobilizon_graphql() {
  if [ -n "${2:-}" ]; then
    curl -sk --max-time 15 https://mobilizon.local/api \
      -H 'Content-Type: application/json' -H "Authorization: Bearer $2" -d "$1"
  else
    curl -sk --max-time 15 https://mobilizon.local/api \
      -H 'Content-Type: application/json' -d "$1"
  fi
}

mobilizon_creds() {
  echo "   account (login e-mail / password → profile):"
  echo "     $MOBILIZON_DEV_EMAIL $MOBILIZON_DEV_PASSWORD → @$MOBILIZON_DEV_USER@mobilizon.local (administrator)"
  echo "   followable group: !plamenu_events@mobilizon.local"
  echo "     (Person actors CANNOT be followed — Mobilizon only allows Groups"
  echo "      and the instance relay actor, so events reach peers via the group)"
}

mobilizon_down() {
  echo ">> Stopping Mobilizon interop stack…"
  mobilizon_compose down
}

mobilizon_status() {
  if mobilizon_compose ps --status running 2>/dev/null | grep -q '('; then
    echo "mobilizon  running   https://mobilizon.local"
  else
    echo "mobilizon  stopped"
  fi
}

mobilizon_logs() {
  mobilizon_compose logs -f "${@:-}"
}

# ── Discourse (source-backed ActivityPub interop peer) ────────────────

discourse_up() {
  echo ">> Starting source-backed Discourse ActivityPub peer…"
  if ! docker_cmd network inspect mastodon-test_internal >/dev/null 2>&1; then
    echo "   the shared 'mastodon-test_internal' network is missing."
    echo "   Start the Mastodon stack first:  ./dev up mastodon"
    return 1
  fi

  # Reconcile the Caddy aliases after a fresh checkout and reload the edited
  # Caddyfile without bouncing the rest of the peer fleet.
  masto_compose up -d caddy >/dev/null
  masto_compose exec -T caddy caddy reload --config /etc/caddy/Caddyfile >/dev/null

  discourse_compose up -d
  discourse_wait_ready
  echo "   https://discourse.local"
  discourse_creds
}

discourse_wait_ready() {
  echo ">> Waiting for https://discourse.local/about.json …"
  for _ in $(seq 1 240); do
    if curl -sk --max-time 5 https://discourse.local/about.json \
        | grep -q 'Discourse ActivityPub interop test'; then
      return 0
    fi
    sleep 2
  done
  echo "   Discourse did not become ready; inspect: ./dev logs discourse"
  return 1
}

discourse_creds() {
  echo "   account (username / email / password):"
  echo "     $DISCOURSE_DEV_USER $DISCOURSE_DEV_EMAIL $DISCOURSE_DEV_PASSWORD (administrator)"
  echo "   followable category: @federation@discourse.local"
}

discourse_down() {
  echo ">> Stopping Discourse ActivityPub peer…"
  discourse_compose down
}

discourse_status() {
  if discourse_compose ps --status running --services 2>/dev/null | grep -qx 'discourse'; then
    echo "discourse  running   https://discourse.local"
  else
    echo "discourse  stopped"
  fi
}

discourse_logs() {
  discourse_compose logs -f "$@"
}

# ── Hubzilla (source-backed native file-object peer) ──────────────────

hubzilla_up() {
  echo ">> Starting source-backed Hubzilla 11.4 + PubCrawl peer…"
  if ! docker_cmd network inspect mastodon-test_internal >/dev/null 2>&1; then
    echo "   the shared 'mastodon-test_internal' network is missing."
    echo "   Start the Mastodon stack first:  ./dev up mastodon"
    return 1
  fi

  # Docker cannot create nested mount targets below the read-only core-source
  # bind. A freshly cloned Hubzilla tree intentionally lacks these generated
  # paths, so prepare all three targets on the host before Compose starts it.
  [[ -f "$HUBZILLA_SOURCE_DIR/index.php" ]] || {
    echo "   pinned Hubzilla source is missing; run ./dev provision-peers"
    return 1
  }
  mkdir -p "$HUBZILLA_SOURCE_DIR/addon" "$HUBZILLA_SOURCE_DIR/store"
  touch "$HUBZILLA_SOURCE_DIR/.htconfig.php"

  masto_compose up -d caddy >/dev/null
  masto_compose exec -T caddy caddy reload --config /etc/caddy/Caddyfile >/dev/null
  hubzilla_compose up -d --wait --build db hubzilla

  echo ">> Enabling PubCrawl and seeding @hazel@hubzilla.local …"
  hubzilla_compose exec -T hubzilla php util/init_sys_channel >/dev/null
  hubzilla_compose exec -T hubzilla php util/config system activitypub_allowed 1 >/dev/null
  hubzilla_compose exec -T hubzilla php util/addons install pubcrawl >/dev/null
  hubzilla_compose exec -T hubzilla php /opt/hubzilla-test/seed.php
  hubzilla_compose up -d cron >/dev/null
  hubzilla_wait_ready
  echo "   https://hubzilla.local"
  hubzilla_creds
}

hubzilla_wait_ready() {
  echo ">> Waiting for https://hubzilla.local/.well-known/webfinger …"
  for _ in $(seq 1 60); do
    if curl -sk --max-time 5 \
        'https://hubzilla.local/.well-known/webfinger?resource=acct:hazel@hubzilla.local' \
        | grep -q 'hazel@hubzilla.local'; then
      return 0
    fi
    sleep 2
  done
  echo "   Hubzilla did not become ready; inspect: ./dev logs hubzilla"
  return 1
}

hubzilla_creds() {
  echo "   account (channel / email / password):"
  echo "     $HUBZILLA_DEV_USER $HUBZILLA_DEV_EMAIL $HUBZILLA_DEV_PASSWORD (administrator)"
  echo "   followable file-object producer: @$HUBZILLA_DEV_USER@hubzilla.local"
}

hubzilla_down() {
  echo ">> Stopping Hubzilla interop stack…"
  hubzilla_compose down
}

hubzilla_status() {
  if hubzilla_compose ps --status running --services 2>/dev/null | grep -qx 'hubzilla'; then
    echo "hubzilla   running   https://hubzilla.local"
  else
    echo "hubzilla   stopped"
  fi
}

hubzilla_logs() {
  hubzilla_compose logs -f "$@"
}

# ── Funkwhale (official-image native Audio peer) ─────────────────────

funkwhale_up() {
  echo ">> Starting Funkwhale 2.0.8 Audio peer…"
  if ! docker_cmd network inspect mastodon-test_internal >/dev/null 2>&1; then
    echo "   the shared 'mastodon-test_internal' network is missing."
    echo "   Start the Mastodon stack first:  ./dev up mastodon"
    return 1
  fi

  masto_compose up -d caddy >/dev/null
  masto_compose exec -T caddy caddy reload --config /etc/caddy/Caddyfile >/dev/null
  funkwhale_compose up -d --wait postgres redis

  echo ">> Migrating Funkwhale database…"
  funkwhale_compose run --rm api funkwhale-manage migrate --noinput
  funkwhale_ensure_account

  funkwhale_compose up -d --wait api celeryworker celerybeat front
  echo ">> Seeding @plamenu_audio@funkwhale.local …"
  funkwhale_compose exec -T api funkwhale-manage shell \
    < "$FUNKWHALE_DIR/seed-channel.py"
  funkwhale_wait_ready
  echo "   https://funkwhale.local"
  funkwhale_creds
}

funkwhale_ensure_account() {
  local exists=0
  if funkwhale_compose run --rm api funkwhale-manage shell -c \
      "from funkwhale_api.users.models import User; raise SystemExit(0 if User.objects.filter(username='$FUNKWHALE_DEV_USER').exists() else 1)" \
      >/dev/null 2>&1; then
    exists=1
  fi

  if [ "$exists" = 1 ]; then
    echo ">> Refreshing standing Funkwhale account credentials…"
    funkwhale_compose run --rm api funkwhale-manage fw users set \
      --no-input --password "$FUNKWHALE_DEV_PASSWORD" \
      --superuser --staff --upload-quota 1000000000 \
      "$FUNKWHALE_DEV_USER" >/dev/null
  else
    echo ">> Creating standing Funkwhale administrator…"
    funkwhale_compose run --rm \
      -e FUNKWHALE_CLI_USER_PASSWORD="$FUNKWHALE_DEV_PASSWORD" \
      api funkwhale-manage fw users create \
      --username "$FUNKWHALE_DEV_USER" \
      --email "$FUNKWHALE_DEV_EMAIL" \
      --superuser --upload-quota 1000000000 >/dev/null
  fi
}

funkwhale_wait_ready() {
  echo ">> Waiting for https://funkwhale.local/.well-known/webfinger …"
  for _ in $(seq 1 60); do
    if curl -sk --max-time 5 \
        'https://funkwhale.local/.well-known/webfinger?resource=acct:plamenu_audio@funkwhale.local' \
        | grep -q 'plamenu_audio'; then
      return 0
    fi
    sleep 2
  done
  echo "   Funkwhale did not become ready; inspect: ./dev logs funkwhale"
  return 1
}

funkwhale_creds() {
  echo "   account (username / email / password):"
  echo "     $FUNKWHALE_DEV_USER $FUNKWHALE_DEV_EMAIL $FUNKWHALE_DEV_PASSWORD (administrator)"
  echo "   followable Audio producer: @plamenu_audio@funkwhale.local"
}

funkwhale_down() {
  echo ">> Stopping Funkwhale interop stack…"
  funkwhale_compose down
}

funkwhale_status() {
  if funkwhale_compose ps --status running --services 2>/dev/null | grep -qx 'front'; then
    echo "funkwhale  running   https://funkwhale.local"
  else
    echo "funkwhale  stopped"
  fi
}

funkwhale_logs() {
  funkwhale_compose logs -f "$@"
}

# ── Dispatch ──────────────────────────────────────────────────────────

action="${1:-status}"
target="${2:-all}"

case "$action" in
  up)
    case "$target" in
      mastodon)   masto_up ;;
      plamenu)    plamenu_up ;;
      pleroma)    pleroma_up ;;
      sharkey)    sharkey_up ;;
      gotosocial) gts_up ;;
      mitra)      mitra_up ;;
      lemmy)      lemmy_up ;;
      peertube)   peertube_up ;;
      owncast)    owncast_up ;;
      mobilizon)  mobilizon_up ;;
      discourse)  discourse_up ;;
      hubzilla)   hubzilla_up ;;
      funkwhale)  funkwhale_up ;;
      plup)       plup_up ;;
      onion)      onion_up ;;
      # `onion` is deliberately not in `all`: it is the only rig that needs
      # the real Tor network, and full-stack boots must stay offline-safe.
      all)        masto_up; discourse_up; hubzilla_up; funkwhale_up; plamenu_up; pleroma_up; sharkey_up; gts_up; mitra_up; lemmy_up; peertube_up; owncast_up; mobilizon_up; plup_up ;;
      *)          echo "unknown target: $target (use mastodon, plamenu, pleroma, plup, sharkey, gotosocial, mitra, lemmy, peertube, owncast, mobilizon, discourse, hubzilla, funkwhale, onion, or all)"; exit 1 ;;
    esac
    ;;

  down)
    case "$target" in
      mastodon)   masto_down ;;
      plamenu)    plamenu_down ;;
      pleroma)    pleroma_down ;;
      sharkey)    sharkey_down ;;
      gotosocial) gts_down ;;
      mitra)      mitra_down ;;
      lemmy)      lemmy_down ;;
      peertube)   peertube_down ;;
      owncast)    owncast_down ;;
      mobilizon)  mobilizon_down ;;
      discourse)  discourse_down ;;
      hubzilla)   hubzilla_down ;;
      funkwhale)  funkwhale_down ;;
      plup)       plup_down ;;
      onion)      onion_down ;;
      all)        onion_down; plup_down; mobilizon_down; owncast_down; peertube_down; lemmy_down; mitra_down; gts_down; sharkey_down; pleroma_down; plamenu_down; funkwhale_down; hubzilla_down; discourse_down; masto_down ;;
      *)          echo "unknown target: $target (use mastodon, plamenu, pleroma, plup, sharkey, gotosocial, mitra, lemmy, peertube, owncast, mobilizon, discourse, hubzilla, funkwhale, onion, or all)"; exit 1 ;;
    esac
    ;;

  status)
    masto_status
    plamenu_status
    pleroma_status
    sharkey_status
    gts_status
    mitra_status
    lemmy_status
    peertube_status
    owncast_status
    mobilizon_status
    discourse_status
    hubzilla_status
    funkwhale_status
    plup_status
    onion_status
    ;;

  creds)
    echo "mastodon   https://mastodon.local"
    masto_creds
    echo "plamenu    https://plamenu.local"
    plamenu_creds
    echo "pleroma    https://pleroma.local"
    pleroma_creds
    echo "sharkey    https://sharkey.local"
    sharkey_creds
    echo "gotosocial https://gotosocial.local"
    gts_creds
    echo "mitra      https://mitra.local"
    mitra_creds
    echo "lemmy      https://lemmy.local"
    lemmy_creds
    echo "peertube   https://peertube.local"
    peertube_creds
    echo "owncast    https://owncast.local"
    owncast_creds
    echo "mobilizon  https://mobilizon.local"
    mobilizon_creds
    echo "discourse  https://discourse.local"
    discourse_creds
    echo "hubzilla   https://hubzilla.local"
    hubzilla_creds
    echo "funkwhale  https://funkwhale.local"
    funkwhale_creds
    echo "plup       https://plup.local"
    plup_creds
    ;;

  logs)
    case "$target" in
      mastodon)   shift 1; masto_logs "$@" ;;
      plamenu)    plamenu_logs ;;
      pleroma)    shift 1; pleroma_logs "$@" ;;
      sharkey)    shift 1; sharkey_logs "$@" ;;
      gotosocial) shift 1; gts_logs "$@" ;;
      mitra)      mitra_logs ;;
      lemmy)      shift 1; lemmy_logs "$@" ;;
      peertube)   shift 1; peertube_logs "$@" ;;
      owncast)    shift 1; owncast_logs "$@" ;;
      mobilizon)  shift 1; mobilizon_logs "$@" ;;
      discourse)  shift 1; discourse_logs "$@" ;;
      hubzilla)   shift 1; hubzilla_logs "$@" ;;
      funkwhale)  shift 1; funkwhale_logs "$@" ;;
      plup)       shift 1; plup_logs "$@" ;;
      onion)      onion_logs ;;
      *)          echo "usage: ./dev logs [mastodon|plamenu|pleroma|plup|sharkey|gotosocial|mitra|lemmy|peertube|owncast|mobilizon|discourse|hubzilla|funkwhale|onion]"; exit 1 ;;
    esac
    ;;

  *)
    echo "usage: ./dev {up|down|status|logs|creds} [mastodon|plamenu|pleroma|plup|sharkey|gotosocial|mitra|lemmy|peertube|owncast|mobilizon|discourse|hubzilla|funkwhale|all]"
    exit 1
    ;;
esac
