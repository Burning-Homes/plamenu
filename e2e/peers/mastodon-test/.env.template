# Identity ------------------------------------------------------------------
LOCAL_DOMAIN=mastodon.local
# We serve over plain HTTP on :3000 for local testing.
RAILS_ENV=production
NODE_ENV=production

# Keep both images on the same successful upstream nightly. This build was
# produced from mastodon/mastodon commit 2b53f93e681b323d6aab7c2dec4db10a0d94a7b1.
MASTODON_IMAGE=ghcr.io/mastodon/mastodon:nightly.2026-08-12@sha256:18199bac92215240c3b748730377ecd011bd5b760b33b5d83e7aaa144b093b2d
STREAMING_IMAGE=ghcr.io/mastodon/mastodon-streaming:nightly.2026-08-12@sha256:eea35d5a768ce00a4fa2582eaacc7e07eb21c899c02d920b7b96d69ebc2beb0c

# Database ------------------------------------------------------------------
DB_HOST=db
DB_PORT=5432
DB_NAME=mastodon_production
DB_USER=mastodon
DB_PASS=mastodon

# Redis ---------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# Streaming -----------------------------------------------------------------
STREAMING_API_BASE_URL=https://mastodon.local

# Mail (no real delivery; accounts are pre-confirmed via tootctl) -----------
SMTP_SERVER=localhost
SMTP_PORT=25
SMTP_FROM_ADDRESS=notifications@mastodon.local
SMTP_DELIVERY_METHOD=test
EMAIL_DOMAIN_ALLOWLIST=mastodon.local

# This is a disposable e2e stack driven by automated tests, not a public
# service. Disable Mastodon's API throttles so full-suite runs do not depend on
# Rack::Attack's Redis counters.
DISABLE_RACK_ATTACK=true

# Secrets (filled in by `./masto setup`) ------------------------------------
SECRET_KEY_BASE=
OTP_SECRET=
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
