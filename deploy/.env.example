# Copy to .env and replace every example value.
PLAMENU_DOMAIN=social.example.com
PLAMENU_WEBXDC_DOMAIN=webxdc.social.example.com
PLAMENU_IMAGE=codefloe.com/plamenu/plamenu@sha256:replace-with-release-digest
# Change this if 172.30.0.0/24 overlaps a host, LAN, or VPN route. Make the
# identical change to trusted_proxies in deploy/plamenu.toml.
PLAMENU_BACKEND_SUBNET=172.30.0.0/24
POSTGRES_DB=plamenu
POSTGRES_USER=plamenu
POSTGRES_PASSWORD=replace-with-a-long-random-password
