# Attendance. Three separate messages rather than one with optional halves: a
# bare "of 40" (capacity known, count not) reads as a missing number.
status-event-attending =
    { $count ->
        [one] { $count } person attending
       *[other] { $count } people attending
    }
status-event-attending-of = { $count } of { $capacity } attending
status-event-capacity =
    { $capacity ->
        [one] { $capacity } place
       *[other] { $capacity } places
    }
# RSVP cluster. Most of these are statements, not controls: an RSVP waits on the
# organizer and may never be answered, so "awaiting approval" has to read as a
# resting state rather than as something still loading.
