# Copy to .staging.env. The local file is ignored because deployment targets,
# SSH identities, and host-specific paths do not belong in public history.
PLAMENU_STAGING_SSH_HOST=deploy@example.com
PLAMENU_STAGING_CONTAINER=plamenu-staging
PLAMENU_STAGING_DOMAIN=staging.example.com

# Defaults shown for discoverability; omit unchanged values from .staging.env.
PLAMENU_STAGING_SERVICE=plamenu
PLAMENU_STAGING_OWNER=plamenu
PLAMENU_STAGING_GROUP=plamenu
PLAMENU_STAGING_TARGET=x86_64-unknown-linux-musl
PLAMENU_STAGING_REMOTE_BIN=/opt/plamenu/plamenu
PLAMENU_STAGING_HEALTH_PATH=/api/v1/instance
PLAMENU_STAGING_HEALTH_ATTEMPTS=30

# For nonstandard/cross toolchains:
# PLAMENU_STAGING_LINKER=x86_64-linux-musl-gcc
# PLAMENU_STAGING_STRIP=llvm-strip
# Host-specific CPU tuning belongs only in .staging.env. Omit this for a
# portable binary or use a baseline supported by every possible target host.
# PLAMENU_STAGING_RUSTFLAGS="-C target-cpu=x86-64-v3"
